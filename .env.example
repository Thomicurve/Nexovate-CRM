# Configuración pública de la aplicación. No copiar secretos del .env existente.
# test:db crea un cluster local nuevo; no acepta TEST_DATABASE_URL, ni siquiera vacía.
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PUBLIC_KEY
# No usar secret keys ni service_role. Contraseñas y cuentas nunca van en fuentes.

# Sólo harness live: valores privados en .env ignorado o entorno del proceso.
# No los necesita la aplicación. Nunca usar passwords reales en este ejemplo.
CRM_LIVE_PROJECT_REF=REPLACE_WITH_EXPLICIT_PROJECT_REF
CRM_OWNER_EMAIL=owner@example.invalid
CRM_PARTNER_EMAIL=partner@example.invalid
CRM_OWNER_PASSWORD=REPLACE_WITH_PRIVATE_TEST_PASSWORD
CRM_PARTNER_PASSWORD=REPLACE_WITH_PRIVATE_TEST_PASSWORD
